# Server Environment
PORT=3000
NODE_ENV=production

# Database (PostgreSQL 18 - Reutilizando paperless-postgres en Docker network)
DB_HOST=paperless-postgres
DB_PORT=5432
DB_USER=expenses_user
DB_PASSWORD=your_secure_expenses_db_password_here
DB_NAME=expenses_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Paperless-ngx Ingestion Integration
PAPERLESS_BASE_URL=http://paperless:8000
PAPERLESS_API_TOKEN=your_paperless_api_token_here
